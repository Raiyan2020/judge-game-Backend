APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime chat: set to `pusher` in production and fill PUSHER_APP_* below.
# `log`/`null` disables realtime (messages only appear on re-fetch).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Pusher (required for live chat when BROADCAST_CONNECTION=pusher)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Agora voice rooms (get real values from the Agora console)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase Cloud Messaging (HTTP v1) service-account JSON path
FIREBASE_CREDENTIALS=

# MyFatoorah payment gateway (defaults in config/payment.php point at sandbox)
MY_FATOORAH_TOKEN=
MY_FATOORAH_URL=https://apitest.myfatoorah.com/v2
# Webhook signing secret from the MyFatoorah portal. When set, incoming webhooks
# are HMAC-verified; when empty, signature checking is OFF (the API re-check
# still gates every paid/refund flip). Register the webhook URL:
#   POST {APP_URL}/api/payment/webhook
MY_FATOORAH_WEBHOOK_SECRET=
# Reject webhooks whose signature doesn't verify. Keep false until you've
# confirmed the canonical-string format against the live account (the API
# re-check gates every flip regardless).
MY_FATOORAH_WEBHOOK_ENFORCE_SIGNATURE=false
